FROM python:3.8 as builder
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /argus
COPY ./requirements.txt ./requirements.txt
RUN python -m venv /argus/venv  \
    && /argus/venv/bin/python -m pip install --upgrade pip \
    && /argus/venv/bin/python -m pip install --no-cache-dir -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/ \
    && apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*


FROM python:3.8
ENV PYTHONUNBUFFERED=1
ENV ARGUS_API_WORKERS=2
WORKDIR /argus
COPY . .
COPY --from=builder /argus/venv/ /argus/venv/
COPY --from=builder /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
RUN mkdir -p /argus/logs/startup

EXPOSE 7777

CMD ["sh", "-c", "exec /argus/venv/bin/gunicorn main:argus -b 0.0.0.0:7777 -w ${ARGUS_API_WORKERS:-2} -k uvicorn.workers.UvicornWorker --log-level info --timeout 120 --graceful-timeout 30 --keep-alive 10 --max-requests 500 --max-requests-jitter 50 --access-logfile - --error-logfile - 2>&1 | tee -a /argus/logs/startup/argus-api.log"]
